# Nebius Token Factory (OpenAI-compatible)
KEPT_NEBIUS_API_KEY=
# KEPT_NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# Optional overrides. Defaults live in src/kept/config.py (single source of truth).
# Model IDs are case-sensitive; list yours with scripts/check_live.py.
# KEPT_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# KEPT_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
# KEPT_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Tavily web research
KEPT_TAVILY_API_KEY=

# Your name, added to drafts after "Best,"
# KEPT_USER_NAME=

# Mail scan: your own addresses (comma-separated), so Kept can tell which emails you wrote.
# KEPT_EMAIL_FROM counts automatically. If empty, Kept guesses from the mailbox you upload.
# KEPT_USER_EMAILS=
# KEPT_INBOX_MAX_EMAILS=40

# Storage
# KEPT_DB_PATH=data/kept.db

# Egress allowlist (comma-separated hostnames). Everything else is blocked.
# KEPT_EGRESS_ALLOWLIST=api.tokenfactory.us-central1.nebius.com,api.tavily.com

# Outbound email (optional). Off unless SMTP_HOST and EMAIL_FROM are set.
# Gmail: smtp.gmail.com, port 587, and a 16-character app password (not your account password).
# KEPT_SMTP_HOST=smtp.gmail.com
# KEPT_SMTP_PORT=587
# KEPT_SMTP_USERNAME=you@gmail.com
# KEPT_SMTP_PASSWORD=
# KEPT_EMAIL_FROM=you@gmail.com
# Addresses or @domains Kept may email, comma-separated. Empty means only EMAIL_FROM itself.
# KEPT_EMAIL_ALLOWED_RECIPIENTS=

# Demo mode (for a public URL): every visitor gets a private, temporary workspace preloaded with
# sample promises, email is forced off, and costly actions are capped. No login needed.
# KEPT_DEMO_MODE=true
# KEPT_DEMO_MAX_SESSIONS=200
# KEPT_DEMO_SESSION_MINUTES=120
# KEPT_DEMO_MAX_NOTES=20
# KEPT_DEMO_MAX_DRAFTS=40
# KEPT_DEMO_MAX_CHECKS=10
# KEPT_DEMO_MAX_INBOX=5
# KEPT_DEMO_MAX_INBOX_EMAILS=12
# KEPT_DEMO_MAX_CONCURRENT=4
# KEPT_DEMO_MAX_NOTE_CHARS=8000
# Optional: a code that lifts one visitor's limits. Put it in the submission's testing notes.
# KEPT_DEMO_ACCESS_CODE=

# Proactive keeping (kept sweep): look this many days ahead, draft at most this many per run.
# KEPT_SWEEP_HORIZON_DAYS=3
# KEPT_SWEEP_MAX_PER_RUN=5
