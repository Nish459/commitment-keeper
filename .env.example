# Nebius Token Factory (OpenAI-compatible)
KEPT_NEBIUS_API_KEY=
KEPT_NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# Model tiers (IDs are case-sensitive; list yours with scripts/check_live.py)
KEPT_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
KEPT_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
KEPT_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Tavily web research
KEPT_TAVILY_API_KEY=

# Storage
KEPT_DB_PATH=data/kept.db

# Egress allowlist (comma-separated hostnames). Everything else is blocked.
KEPT_EGRESS_ALLOWLIST=api.tokenfactory.us-central1.nebius.com,api.tavily.com
